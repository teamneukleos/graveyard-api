// Graveyard — celebrate unseen creative work
// NestJS + Prisma + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CREATOR
  JUDGE
  ADMIN
  SUPER_ADMIN
}

enum SubmitterType {
  INDIVIDUAL
  AGENCY
}

enum SubmissionStatus {
  DRAFT
  PUBLISHED
  UNDER_REVIEW
  SHORTLISTED
  WINNER
  ARCHIVED
}

enum AssetType {
  IMAGE
  VIDEO
  PDF
  DECK
  OTHER
}

enum AwardCycleStatus {
  UPCOMING
  JUDGING
  RESULTS_PUBLISHED
  CLOSED
}

enum AwardPlacement {
  SHORTLISTED
  WINNER
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CREATOR)
  bio          String?
  agencyName   String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions      Submission[]
  likes            Like[]
  judgeAssignments JudgeAssignment[]
  judgeScores      JudgeScore[]

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
  awardResults AwardResult[]

  @@map("categories")
}

model Submission {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  categoryId     String
  creatorId      String
  submitterType  SubmitterType    @default(INDIVIDUAL)
  yearCreated    Int
  concept        String
  whyNeverLived  String
  rightsAttested Boolean          @default(false)
  status         SubmissionStatus @default(DRAFT)
  likeCount      Int              @default(0)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id])
  creator      User          @relation(fields: [creatorId], references: [id])
  teamMembers  TeamMember[]
  assets       Asset[]
  likes        Like[]
  judgeScores  JudgeScore[]
  awardResults AwardResult[]
  featuredItems FeaturedItem[]

  @@index([status])
  @@index([categoryId])
  @@index([creatorId])
  @@index([yearCreated])
  @@index([likeCount])
  @@map("submissions")
}

model TeamMember {
  id           String @id @default(cuid())
  submissionId String
  name         String
  roleTitle    String?
  sortOrder    Int    @default(0)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("team_members")
}

model Asset {
  id           String    @id @default(cuid())
  submissionId String
  type         AssetType
  url          String
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  sortOrder    Int       @default(0)
  isCover      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("assets")
}

model Like {
  id           String   @id @default(cuid())
  submissionId String
  userId       String
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([submissionId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("likes")
}

model AwardCycle {
  id            String           @id @default(cuid())
  name          String
  year          Int
  startsAt      DateTime
  endsAt        DateTime?
  judgingEndsAt DateTime?
  status        AwardCycleStatus @default(UPCOMING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  judgeAssignments JudgeAssignment[]
  judgeScores      JudgeScore[]
  awardResults     AwardResult[]

  @@unique([year, name])
  @@index([status])
  @@map("award_cycles")
}

model JudgeAssignment {
  id           String   @id @default(cuid())
  awardCycleId String
  userId       String
  createdAt    DateTime @default(now())

  awardCycle AwardCycle @relation(fields: [awardCycleId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([awardCycleId, userId])
  @@map("judge_assignments")
}

model JudgeScore {
  id           String   @id @default(cuid())
  awardCycleId String
  submissionId String
  judgeId      String
  concept      Int
  craft        Int
  story        Int
  deservedLife Int
  total        Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  awardCycle AwardCycle @relation(fields: [awardCycleId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge      User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([awardCycleId, submissionId, judgeId])
  @@index([submissionId])
  @@index([judgeId])
  @@map("judge_scores")
}

model AwardResult {
  id           String         @id @default(cuid())
  awardCycleId String
  submissionId String
  categoryId   String
  placement    AwardPlacement
  publishedAt  DateTime       @default(now())

  awardCycle AwardCycle @relation(fields: [awardCycleId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id])

  @@unique([awardCycleId, submissionId])
  @@index([categoryId])
  @@index([placement])
  @@map("award_results")
}

model FeaturedItem {
  id           String    @id @default(cuid())
  submissionId String
  title        String?
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([isActive, sortOrder])
  @@map("featured_items")
}
