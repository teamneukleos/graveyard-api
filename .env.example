NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:root@localhost:5434/graveyard?schema=public

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3001,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# Frontend base URL used in verification / password-reset links
FRONTEND_URL=http://localhost:3001

# Resend — https://resend.com/api-keys
# Leave blank locally to log email links instead of sending
RESEND_API_KEY=
EMAIL_FROM="Graveyard <onboarding@resend.dev>"
PASSWORD_RESET_EXPIRES_MINUTES=30

# Google OAuth (sign-in) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Optional; falls back to JWT_SECRET
GOOGLE_OAUTH_STATE_SECRET=

# Bootstrap admin created by `npm run prisma:seed`
SEED_ADMIN_EMAIL=admin@graveyard.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin1!
SEED_ADMIN_NAME=Super Admin
# When true, seed resets the admin password to SEED_ADMIN_PASSWORD
SEED_ADMIN_RESET_PASSWORD=true

# Storage: local (dev default) or r2 (Cloudflare R2)
STORAGE_DRIVER=local
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=graveyard-assets
# Public URL for objects (R2 custom domain or pub-*.r2.dev)
# R2_PUBLIC_BASE_URL=https://assets.example.com
# Optional override (defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
